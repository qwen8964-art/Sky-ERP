# Variables de entorno para SKYNET ERP API

# Servidor
PORT=3001
NODE_ENV=development

# Base de datos PostgreSQL
DATABASE_URL="postgresql://skynet_user:skynet_password@localhost:5432/skynet_erp?schema=public"

# JWT
JWT_SECRET="skynet-erp-super-secret-key-change-this-in-production-2024"
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS (orígenes permitidos)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Logging
LOG_LEVEL=debug

# ========================================
# MIGRACIÓN DE DATOS (FASE 4)
# ========================================

# MySQL Legacy (Origen de migración)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=tu_password_mysql
MYSQL_DATABASE=skynet_erp_legacy

# ========================================
