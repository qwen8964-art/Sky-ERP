generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// EMPRESAS Y ESTRUCTURA ORGANIZACIONAL
// ============================================

model MiEmpresa {
  id_mi_empresa   Int     @id @default(autoincrement())
  ruc             String  @db.VarChar(11)
  razon_social    String  @db.VarChar(200)
  nombre_fantasia String? @db.VarChar(200)
  direccion       String? @db.VarChar(300)
  telefono        String? @db.VarChar(20)
  email           String? @db.VarChar(100)
  igv             Decimal @default(18.0) @db.Decimal(5, 2)
  moneda          String  @default("PEN") @db.VarChar(3)
  activo          Boolean @default(true)

  sedes    MiSede[]
  usuarios UsuarioSkynet[]
  personas Persona[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mi_empresa")
}

model MiSede {
  id_mi_sede    Int     @id @default(autoincrement())
  id_mi_empresa Int
  nombre        String  @db.VarChar(100)
  direccion     String? @db.VarChar(300)
  telefono      String? @db.VarChar(20)
  activo        Boolean @default(true)

  empresa      MiEmpresa         @relation(fields: [id_mi_empresa], references: [id_mi_empresa])
  almacenes    MiAlmacen[]
  usuarios     UsuarioSkynet[]
  correlativos CorrelativosDoc[]
  listasPrecio TipoListaPrecio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mi_sede")
}

model MiAlmacen {
  id_mi_almacen Int     @id @default(autoincrement())
  id_mi_sede    Int
  nombre        String  @db.VarChar(100)
  direccion     String? @db.VarChar(300)
  responsable   String? @db.VarChar(100)
  activo        Boolean @default(true)

  sede     MiSede          @relation(fields: [id_mi_sede], references: [id_mi_sede])
  usuarios UsuarioSkynet[]
  stocks   AlmStock[]
  guias    AlmGuia[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  StockSeries StockSeries[]

  @@map("mi_almacen")
}

// ============================================
// USUARIOS Y SEGURIDAD
// ============================================

model UsuarioSkynet {
  id_usuario    Int       @id @default(autoincrement())
  id_mi_empresa Int
  id_mi_sede    Int?
  id_mi_almacen Int?
  login         String    @unique @db.VarChar(50)
  password      String    @db.VarChar(255)
  nombres       String    @db.VarChar(100)
  apellidos     String    @db.VarChar(100)
  email         String?   @db.VarChar(100)
  activo        Boolean   @default(true)
  bloqueado     Boolean   @default(false)
  ultima_sesion DateTime?

  empresa     MiEmpresa           @relation(fields: [id_mi_empresa], references: [id_mi_empresa])
  sede        MiSede?             @relation(fields: [id_mi_sede], references: [id_mi_sede])
  almacen     MiAlmacen?          @relation(fields: [id_mi_almacen], references: [id_mi_almacen])
  privilegios UsuarioPrivilegio[]
  sesiones    UsuarioSesion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("usuarios_skynet")
}

model UsuarioPrivilegio {
  id_privilegio Int     @id @default(autoincrement())
  id_usuario    Int
  id_arbol      Int
  ver           Boolean @default(false)
  crear         Boolean @default(false)
  editar        Boolean @default(false)
  eliminar      Boolean @default(false)
  aprobar       Boolean @default(false)

  usuario UsuarioSkynet @relation(fields: [id_usuario], references: [id_usuario])
  arbol   ArbolDet      @relation(fields: [id_arbol], references: [id_arbol])

  @@map("usuario_privilegios")
}

model UsuarioSesion {
  id_sesion  Int       @id @default(autoincrement())
  id_usuario Int
  token      String    @unique @db.VarChar(500)
  ip_address String?   @db.VarChar(45)
  user_agent String?   @db.VarChar(500)
  inicio     DateTime  @default(now())
  fin        DateTime?
  activa     Boolean   @default(true)

  usuario UsuarioSkynet @relation(fields: [id_usuario], references: [id_usuario])

  @@map("usuario_sesiones")
}

model ArbolDet {
  id_arbol    Int     @id @default(autoincrement())
  codigo      String  @unique @db.VarChar(20)
  descripcion String  @db.VarChar(100)
  id_padre    Int?
  modulo      String  @db.VarChar(2) // VE, CO, AL, TE, PR, CA, PL, CT, CR, TPV
  orden       Int     @default(0)
  icono       String? @db.VarChar(50)
  ruta        String? @db.VarChar(200)
  activo      Boolean @default(true)

  padre       ArbolDet?           @relation("ArbolHierarchy", fields: [id_padre], references: [id_arbol])
  hijos       ArbolDet[]          @relation("ArbolHierarchy")
  privilegios UsuarioPrivilegio[]

  @@map("arbol_det")
}

// ============================================
// PERSONAS (CLIENTES, PROVEEDORES, VENDEDORES)
// ============================================

model Persona {
  id_persona       Int       @id @default(autoincrement())
  id_mi_empresa    Int
  tipo_persona     String    @db.VarChar(20) // NATURAL, JURIDICA
  tipo_documento   String    @default("RUC") @db.VarChar(20) // RUC, DNI, CE, PASAPORTE
  numero_documento String    @db.VarChar(20)
  razon_social     String?   @db.VarChar(200)
  apellido_paterno String?   @db.VarChar(50)
  apellido_materno String?   @db.VarChar(50)
  nombres          String?   @db.VarChar(100)
  nombre_comercial String?   @db.VarChar(200)
  direccion        String?   @db.VarChar(300)
  telefono         String?   @db.VarChar(20)
  celular          String?   @db.VarChar(20)
  email            String?   @db.VarChar(100)
  fecha_nacimiento DateTime?
  estado_civil     String?   @db.VarChar(20)
  genero           String?   @db.VarChar(10)
  activo           Boolean   @default(true)

  empresa MiEmpresa @relation(fields: [id_mi_empresa], references: [id_mi_empresa])

  cliente   Cliente?
  proveedor Proveedor?
  vendedor  Vendedore?

  // Documentos de venta
  cotizaciones      Cotizacion[]
  comprobantesVenta ComprobanteVenta[]
  ctasCobrar        CtasCobrar[]

  // Documentos de compra
  comprobantesCompra ComprobanteCompra[]
  ctasPagar          CtasPagar[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("persona")
}

model Cliente {
  id_cliente           Int     @id @default(autoincrement())
  id_persona           Int     @unique
  limite_credito       Decimal @default(0) @db.Decimal(15, 2)
  dias_credito         Int     @default(0)
  descuento_porcentaje Decimal @default(0) @db.Decimal(5, 2)
  lista_precio_default Int?
  activo               Boolean @default(true)

  persona Persona @relation(fields: [id_persona], references: [id_persona])

  @@map("cliente")
}

model Proveedor {
  id_proveedor          Int      @id @default(autoincrement())
  id_persona            Int      @unique
  tipo_contribuyente    String?  @db.VarChar(50) // General, Especial, RER
  porcentaje_retencion  Decimal? @db.Decimal(5, 2)
  porcentaje_percepcion Decimal? @db.Decimal(5, 2)
  cuenta_bancaria       String?  @db.VarChar(50)
  banco                 String?  @db.VarChar(100)
  activo                Boolean  @default(true)

  persona Persona @relation(fields: [id_persona], references: [id_persona])

  @@map("proveedor")
}

model Vendedore {
  id_vendedor         Int      @id @default(autoincrement())
  id_persona          Int      @unique
  codigo              String   @unique @db.VarChar(20)
  comision_porcentaje Decimal  @default(0) @db.Decimal(5, 2)
  meta_venta          Decimal? @db.Decimal(15, 2)
  activo              Boolean  @default(true)

  persona      Persona            @relation(fields: [id_persona], references: [id_persona])
  comprobantes ComprobanteVenta[]
  Cotizacion   Cotizacion[]

  @@map("vendedores")
}

// ============================================
// PRODUCTOS E INVENTARIO
// ============================================

model FamiliaGrupo {
  id_familia_grupo Int     @id @default(autoincrement())
  codigo           String  @unique @db.VarChar(20)
  descripcion      String  @db.VarChar(100)
  id_padre         Int?
  nivel            Int     @default(1)
  tipo             String  @db.VarChar(20) // FAMILIA, GRUPO
  activo           Boolean @default(true)

  padre     FamiliaGrupo?  @relation("FamiliaHierarchy", fields: [id_padre], references: [id_familia_grupo])
  hijos     FamiliaGrupo[] @relation("FamiliaHierarchy")
  productos Productos[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("familia_grupo")
}

model Productos {
  id_producto      Int      @id @default(autoincrement())
  id_familia_grupo Int?
  codigo           String   @unique @db.VarChar(50)
  codigo_barra     String?  @db.VarChar(50)
  nombre           String   @db.VarChar(200)
  descripcion      String?  @db.Text
  unidad_medida    String   @default("UND") @db.VarChar(20)
  equivalencia     Decimal  @default(1) @db.Decimal(15, 4)
  stock_minimo     Decimal  @default(0) @db.Decimal(15, 4)
  stock_maximo     Decimal? @db.Decimal(15, 4)
  precio_compra    Decimal  @default(0) @db.Decimal(15, 4)
  controla_series  Boolean  @default(false)
  tipo_impuesto    String   @default("GRAVADO") @db.VarChar(20) // GRAVADO, EXONERADO, INAFECTO
  activo           Boolean  @default(true)

  familia FamiliaGrupo? @relation(fields: [id_familia_grupo], references: [id_familia_grupo])

  precios PrecioVentaProducto[]
  stocks  AlmStock[]
  series  StockSeries[]
  kardex  Kardex[]

  // Producción
  formulaDetalle ProduccionFormulaDetalle[]

  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  CotizacionDetalle        CotizacionDetalle[]
  ComprobanteVentaDetalle  ComprobanteVentaDetalle[]
  ComprobanteCompraDetalle ComprobanteCompraDetalle[]
  AlmGuiaDetalle           AlmGuiaDetalle[]
  ProduccionFormula        ProduccionFormula[]

  @@map("productos")
}

model TipoListaPrecio {
  id_lista_precio   Int     @id @default(autoincrement())
  id_mi_sede        Int
  nombre            String  @db.VarChar(100)
  descripcion       String? @db.VarChar(300)
  moneda            String  @default("PEN") @db.VarChar(3)
  porcentaje_global Decimal @default(0) @db.Decimal(5, 2)
  activo            Boolean @default(true)

  sede    MiSede                @relation(fields: [id_mi_sede], references: [id_mi_sede])
  precios PrecioVentaProducto[]

  @@map("tipo_lista_precio")
}

model PrecioVentaProducto {
  id_precio       Int       @id @default(autoincrement())
  id_producto     Int
  id_lista_precio Int
  precio          Decimal   @db.Decimal(15, 4)
  moneda          String    @default("PEN") @db.VarChar(3)
  vigente_desde   DateTime  @default(now())
  vigente_hasta   DateTime?

  producto     Productos       @relation(fields: [id_producto], references: [id_producto])
  lista_precio TipoListaPrecio @relation(fields: [id_lista_precio], references: [id_lista_precio])

  @@map("precio_venta_productos")
}

model AlmStock {
  id_stock       Int     @id @default(autoincrement())
  id_producto    Int
  id_mi_almacen  Int
  cantidad       Decimal @default(0) @db.Decimal(15, 4)
  costo_promedio Decimal @default(0) @db.Decimal(15, 4)

  producto Productos @relation(fields: [id_producto], references: [id_producto])
  almacen  MiAlmacen @relation(fields: [id_mi_almacen], references: [id_mi_almacen])

  @@unique([id_producto, id_mi_almacen])
  @@map("alm_stock")
}

model StockSeries {
  id_serie       Int     @id @default(autoincrement())
  id_producto    Int
  id_mi_almacen  Int
  numero_serie   String  @db.VarChar(100)
  estado         String  @default("DISPONIBLE") @db.VarChar(20) // DISPONIBLE, ASIGNADO, VENDIDO
  id_documento   Int?
  tipo_documento String? @db.VarChar(20)

  producto Productos @relation(fields: [id_producto], references: [id_producto])
  almacen  MiAlmacen @relation(fields: [id_mi_almacen], references: [id_mi_almacen])

  @@map("stock_series")
}

model Kardex {
  id_kardex        Int      @id @default(autoincrement())
  id_producto      Int
  id_mi_almacen    Int
  fecha            DateTime @default(now())
  tipo_operacion   String   @db.VarChar(20) // INGRESO, SALIDA
  tipo_documento   String   @db.VarChar(20)
  numero_documento String   @db.VarChar(50)
  cantidad         Decimal  @db.Decimal(15, 4)
  costo_unitario   Decimal  @db.Decimal(15, 4)
  costo_total      Decimal  @db.Decimal(15, 4)
  saldo_cantidad   Decimal  @db.Decimal(15, 4)
  referencia       String?  @db.VarChar(300)

  producto Productos @relation(fields: [id_producto], references: [id_producto])

  @@map("kardex")
}

// ============================================
// DOCUMENTOS DE VENTA
// ============================================

model CorrelativosDoc {
  id_correlativo Int     @id @default(autoincrement())
  id_mi_sede     Int
  tipo_documento String  @db.VarChar(10) // FACT, BOL, NC, ND, COT, GS, GI, GR, OC
  serie          String  @db.VarChar(10)
  correlativo    Int     @default(0)
  activo         Boolean @default(true)

  sede MiSede @relation(fields: [id_mi_sede], references: [id_mi_sede])

  @@unique([id_mi_sede, tipo_documento, serie])
  @@map("correlativos_doc")
}

model Cotizacion {
  id_cotizacion Int      @id @default(autoincrement())
  numero        String   @unique @db.VarChar(50)
  fecha         DateTime @default(now())
  id_cliente    Int
  id_vendedor   Int?
  id_mi_sede    Int
  id_mi_almacen Int
  estado        String   @default("BORRADOR") @db.VarChar(20) // BORRADOR, APROBADA, ANULADA, CONVERTIDA
  tipo_cambio   Decimal  @default(1) @db.Decimal(10, 4)
  subtotal      Decimal  @default(0) @db.Decimal(15, 2)
  igv           Decimal  @default(0) @db.Decimal(15, 2)
  total         Decimal  @default(0) @db.Decimal(15, 2)
  observaciones String?  @db.Text
  validez_dias  Int      @default(7)

  cliente  Persona             @relation(fields: [id_cliente], references: [id_persona])
  vendedor Vendedore?          @relation(fields: [id_vendedor], references: [id_vendedor])
  detalle  CotizacionDetalle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cotizacion")
}

model CotizacionDetalle {
  id_detalle      Int     @id @default(autoincrement())
  id_cotizacion   Int
  id_producto     Int
  cantidad        Decimal @db.Decimal(15, 4)
  precio_unitario Decimal @db.Decimal(15, 4)
  descuento       Decimal @default(0) @db.Decimal(15, 4)
  impuesto        Boolean @default(true)
  subtotal        Decimal @db.Decimal(15, 4)
  igv             Decimal @db.Decimal(15, 4)
  total           Decimal @db.Decimal(15, 4)
  observaciones   String? @db.VarChar(300)

  cotizacion Cotizacion @relation(fields: [id_cotizacion], references: [id_cotizacion])
  producto   Productos  @relation(fields: [id_producto], references: [id_producto])

  @@map("cotizacion_detalle")
}

model ComprobanteVenta {
  id_comprobante    Int       @id @default(autoincrement())
  tipo_comprobante  String    @db.VarChar(10) // FACT, BOL, NC, ND
  serie             String    @db.VarChar(10)
  numero            String    @db.VarChar(20)
  fecha_emision     DateTime  @default(now())
  fecha_vencimiento DateTime?
  id_cliente        Int
  id_vendedor       Int?
  id_mi_sede        Int
  id_mi_almacen     Int
  estado            String    @default("BORRADOR") @db.VarChar(20) // BORRADOR, APROBADO, ANULADO
  tipo_cambio       Decimal   @default(1) @db.Decimal(10, 4)
  subtotal          Decimal   @default(0) @db.Decimal(15, 2)
  igv               Decimal   @default(0) @db.Decimal(15, 2)
  percepcion        Decimal?  @db.Decimal(15, 2)
  retencion         Decimal?  @db.Decimal(15, 2)
  total             Decimal   @default(0) @db.Decimal(15, 2)
  observaciones     String?   @db.Text
  guia_salida       String?   @db.VarChar(50)
  id_cotizacion     Int?

  cliente      Persona                   @relation(fields: [id_cliente], references: [id_persona])
  vendedor     Vendedore?                @relation(fields: [id_vendedor], references: [id_vendedor])
  detalle      ComprobanteVentaDetalle[]
  ctasCobrar   CtasCobrar[]
  notasCredito NotaCredito[]
  notasDebito  NotaDebito[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comprobante_venta")
}

model ComprobanteVentaDetalle {
  id_detalle      Int     @id @default(autoincrement())
  id_comprobante  Int
  id_producto     Int
  cantidad        Decimal @db.Decimal(15, 4)
  precio_unitario Decimal @db.Decimal(15, 4)
  descuento       Decimal @default(0) @db.Decimal(15, 4)
  impuesto        Boolean @default(true)
  subtotal        Decimal @db.Decimal(15, 4)
  igv             Decimal @db.Decimal(15, 4)
  total           Decimal @db.Decimal(15, 4)

  comprobante ComprobanteVenta @relation(fields: [id_comprobante], references: [id_comprobante])
  producto    Productos        @relation(fields: [id_producto], references: [id_producto])

  @@map("comprobante_venta_detalle")
}

model NotaCredito {
  id_nota_credito      Int      @id @default(autoincrement())
  serie                String   @db.VarChar(10)
  numero               String   @db.VarChar(20)
  fecha_emision        DateTime @default(now())
  id_comprobante_venta Int
  id_cliente           Int
  motivo               String   @db.VarChar(200) // DEVOLUCION, DESCUENTO, BONO, etc.
  tipo_cambio          Decimal  @default(1) @db.Decimal(10, 4)
  subtotal             Decimal  @default(0) @db.Decimal(15, 2)
  igv                  Decimal  @default(0) @db.Decimal(15, 2)
  total                Decimal  @default(0) @db.Decimal(15, 2)
  estado               String   @default("PENDIENTE") @db.VarChar(20)

  comprobante_venta ComprobanteVenta @relation(fields: [id_comprobante_venta], references: [id_comprobante])

  @@map("nota_credito")
}

model NotaDebito {
  id_nota_debito       Int      @id @default(autoincrement())
  serie                String   @db.VarChar(10)
  numero               String   @db.VarChar(20)
  fecha_emision        DateTime @default(now())
  id_comprobante_venta Int
  id_cliente           Int
  motivo               String   @db.VarChar(200)
  tipo_cambio          Decimal  @default(1) @db.Decimal(10, 4)
  subtotal             Decimal  @default(0) @db.Decimal(15, 2)
  igv                  Decimal  @default(0) @db.Decimal(15, 2)
  total                Decimal  @default(0) @db.Decimal(15, 2)
  estado               String   @default("PENDIENTE") @db.VarChar(20)

  comprobante_venta ComprobanteVenta @relation(fields: [id_comprobante_venta], references: [id_comprobante])

  @@map("nota_debito")
}

// ============================================
// DOCUMENTOS DE COMPRA
// ============================================

model ComprobanteCompra {
  id_comprobante    Int       @id @default(autoincrement())
  tipo_comprobante  String    @db.VarChar(10)
  serie             String    @db.VarChar(10)
  numero            String    @db.VarChar(20)
  fecha_emision     DateTime  @default(now())
  fecha_vencimiento DateTime?
  id_proveedor      Int
  id_mi_sede        Int
  id_mi_almacen     Int
  estado            String    @default("BORRADOR") @db.VarChar(20)
  tipo_cambio       Decimal   @default(1) @db.Decimal(10, 4)
  subtotal          Decimal   @default(0) @db.Decimal(15, 2)
  igv               Decimal   @default(0) @db.Decimal(15, 2)
  percepcion        Decimal?  @db.Decimal(15, 2)
  retencion         Decimal?  @db.Decimal(15, 2)
  total             Decimal   @default(0) @db.Decimal(15, 2)
  observaciones     String?   @db.Text

  proveedor Persona                    @relation(fields: [id_proveedor], references: [id_persona])
  detalle   ComprobanteCompraDetalle[]
  ctasPagar CtasPagar[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comprobante_compra")
}

model ComprobanteCompraDetalle {
  id_detalle      Int     @id @default(autoincrement())
  id_comprobante  Int
  id_producto     Int?
  descripcion     String  @db.VarChar(300)
  cantidad        Decimal @db.Decimal(15, 4)
  precio_unitario Decimal @db.Decimal(15, 4)
  descuento       Decimal @default(0) @db.Decimal(15, 4)
  impuesto        Boolean @default(true)
  subtotal        Decimal @db.Decimal(15, 4)
  igv             Decimal @db.Decimal(15, 4)
  total           Decimal @db.Decimal(15, 4)

  comprobante ComprobanteCompra @relation(fields: [id_comprobante], references: [id_comprobante])
  producto    Productos?        @relation(fields: [id_producto], references: [id_producto])

  @@map("comprobante_compra_detalle")
}

// ============================================
// ALMACÉN - GUÍAS
// ============================================

model AlmGuia {
  id_guia              Int      @id @default(autoincrement())
  id_mi_almacen        Int
  tipo_guia            String   @db.VarChar(10) // GI (Ingreso), GS (Salida)
  numero               String   @db.VarChar(50)
  fecha                DateTime @default(now())
  id_motivo            Int?
  tipo_documento_ref   String?  @db.VarChar(20)
  numero_documento_ref String?  @db.VarChar(50)
  id_tercero           Int?
  estado               String   @default("ACTIVA") @db.VarChar(20)
  observaciones        String?  @db.Text

  almacen MiAlmacen        @relation(fields: [id_mi_almacen], references: [id_mi_almacen])
  detalle AlmGuiaDetalle[]

  @@map("alm_guia")
}

model AlmGuiaDetalle {
  id_detalle     Int     @id @default(autoincrement())
  id_guia        Int
  id_producto    Int
  cantidad       Decimal @db.Decimal(15, 4)
  costo_unitario Decimal @db.Decimal(15, 4)
  subtotal       Decimal @db.Decimal(15, 4)
  igv            Decimal @db.Decimal(15, 4)
  total          Decimal @db.Decimal(15, 4)

  guia     AlmGuia   @relation(fields: [id_guia], references: [id_guia])
  producto Productos @relation(fields: [id_producto], references: [id_producto])

  @@map("alm_guia_detalle")
}

model MotivoGuia {
  id_motivo   Int     @id @default(autoincrement())
  codigo      String  @unique @db.VarChar(10)
  descripcion String  @db.VarChar(100)
  tipo        String  @db.VarChar(10) // INGRESO, SALIDA
  activo      Boolean @default(true)

  @@map("motivo_guia")
